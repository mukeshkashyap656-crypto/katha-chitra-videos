[{"id": "f1", "text": "सोचो... आपने गेम बंद कर दिया।", "who": "n", "voice": "hi-IN-MadhurNeural", "words": [["सोचो", 0.097166, 0.507083], ["आपने", 1.521208, 0.424541], ["गेम", 1.94575, 0.365583], ["बंद", 2.311333, 0.247625], ["कर", 2.594333, 0.176875], ["दिया", 2.771208, 0.306583]]}, {"id": "f2", "text": "पर आपका प्लेयर रुकता ही नहीं!", "who": "n", "voice": "hi-IN-MadhurNeural", "words": [["पर", 0.097166, 0.153291], ["आपका", 0.356583, 0.377375], ["प्लेयर", 0.74575, 0.342], ["रुकता", 1.08775, 0.365541], ["ही", 1.453291, 0.129708], ["नहीं", 1.583, 0.424541]]}, {"id": "f3", "text": "वो बस भागता ही जाता है।", "who": "n", "voice": "hi-IN-MadhurNeural", "words": [["वो", 0.097166, 0.21225], ["बस", 0.309416, 0.271208], ["भागता", 0.580666, 0.495291], ["ही", 1.075958, 0.1415], ["जाता", 1.241041, 0.365541], ["है", 1.606583, 0.294791]]}, {"id": "f4", "text": "फिर रुककर, इधर-उधर देखता है।", "who": "n", "voice": "hi-IN-MadhurNeural", "words": [["फिर", 0.097166, 0.235833], ["रुककर", 0.333, 0.436333], ["इधर-उधर", 0.922625, 0.507083], ["देखता", 1.429708, 0.459916], ["है", 1.889625, 0.306583]]}, {"id": "f5", "text": "सामने एक अनजान दरवाज़ा है... अंदर कौन है?", "who": "n", "voice": "hi-IN-MadhurNeural", "words": [["सामने", 0.097166, 0.459916], ["एक", 0.639625, 0.235833], ["अनजान", 0.875458, 0.507083], ["दरवाज़ा", 1.394333, 0.55425], ["है", 1.972166, 0.294791], ["अंदर", 3.514166, 0.330166], ["कौन", 3.844333, 0.294791], ["है", 4.139166, 0.318416]]}, {"id": "f6", "text": "आपको क्या लगता है? कमेंट में बताओ!", "who": "n", "voice": "hi-IN-MadhurNeural", "words": [["आपको", 0.097166, 0.389166], ["क्या", 0.486333, 0.235833], ["लगता", 0.722166, 0.389166], ["है", 1.111333, 0.294791], ["कमेंट", 2.700458, 0.318416], ["में", 3.018875, 0.165083], ["बताओ", 3.183958, 0.530666]]}]